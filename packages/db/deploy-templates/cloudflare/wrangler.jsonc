{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bql-preview-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "containers": [{
    "class_name": "DatabaseContainer",
    "image": "./Dockerfile",
    "image_build_context": "../..",
    "max_instances": 1,
    "instance_type": "basic"
  }],
  "durable_objects": { "bindings": [{ "name": "DATABASE", "class_name": "DatabaseContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DatabaseContainer"] }],
  "vars": {
    "BQL_DEPLOYMENT_ENV": "preview",
    "BQL_DATA_DEPLOYMENT_ID": "preview-example",
    "BQL_S3_BUCKET": "bql-preview-example",
    "BQL_S3_ENDPOINT": "https://ACCOUNT_ID.r2.cloudflarestorage.com"
  }
}

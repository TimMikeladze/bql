{
  "name": "bql-bus",
  "private": true,
  "type": "module",
  "description": "A durable message bus for agents and ordinary work \u2014 Bun, SQLite, subjects, consumer groups, leases Published as part of `bql.sh`; this manifest is for development only.",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "serve": "bun src/cli/index.ts serve",
    "build": "bunup && vite build",
    "build:dashboard": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "test:e2e": "bun scripts/e2e.ts",
    "soak": "bun scripts/soak.ts",
    "build:binary": "bun scripts/build-binary.ts",
    "test:compiled": "bun scripts/compiled-e2e.ts",
    "drill:restore": "bun scripts/restore-drill.ts",
    "drill:failover": "bun scripts/failover-drill.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "bunup": "^0.16.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}

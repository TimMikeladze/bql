{
  "name": "agenticbus",
  "version": "0.1.0",
  "description": "A durable message bus for agents and ordinary work \u2014 Bun, SQLite, subjects, consumer groups, leases",
  "keywords": [
    "message-bus",
    "message-queue",
    "pubsub",
    "work-queue",
    "request-reply",
    "durable",
    "at-least-once",
    "bun",
    "sqlite",
    "agents"
  ],
  "license": "MIT",
  "author": "Tim Mikeladze <tim.mikeladze@gmail.com>",
  "homepage": "https://github.com/TimMikeladze/agenticbus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimMikeladze/agenticbus.git"
  },
  "bugs": {
    "url": "https://github.com/TimMikeladze/agenticbus/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "agenticbus": "./src/cli/index.ts"
  },
  "files": [
    "dist",
    "!dist/bin"
  ],
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      }
    },
    "./client": {
      "import": {
        "types": "./src/client/bus.ts",
        "default": "./src/client/bus.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "serve": "bun src/cli/index.ts serve",
    "build": "bunup && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "test:e2e": "bun scripts/e2e.ts",
    "soak": "bun scripts/soak.ts",
    "verify-pack": "bun scripts/verify-pack.ts",
    "prepack": "bun run build && bun scripts/prepack.ts",
    "postpack": "bun scripts/prepack.ts --restore",
    "build:binary": "bun scripts/build-binary.ts",
    "test:compiled": "bun scripts/compiled-e2e.ts",
    "drill:restore": "bun scripts/restore-drill.ts",
    "drill:failover": "bun scripts/failover-drill.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "bunup": "^0.16.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
